{
  "name": "workpack",
  "version": "0.2.0",
  "description": "WorkPack 项目业务文件管理",
  "main": "out/main/index.js",
  "author": "WorkPack",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "test": "node scripts/test.cjs",
    "test:e2e": "npm run build && playwright test",
    "pack": "npm run build && electron-builder --win --dir --publish never",
    "dist": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^42.11.18",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  },
  "build": {
    "appId": "com.workpack.desktop",
    "productName": "WorkPack",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/better-sqlite3/{deps,src}/**"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WorkPack",
      "uninstallDisplayName": "WorkPack",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "include": "build/installer.nsh"
    },
    "artifactName": "WorkPack-${version}-Setup.${ext}"
  },
  "overrides": {
    "minimatch@>=9 <11": "11.0.4"
  }
}
